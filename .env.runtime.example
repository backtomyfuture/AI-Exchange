# Runtime mode: development, test, or production.
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO
EXTERNAL_URL=http://localhost:8000

# Restricted PostgreSQL runtime identity only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=email_agent
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_MIGRATION_OWNER_ROLE=ai_exchange_migration_owner
DATABASE_ROLE_SEPARATION_REQUIRED=false

# Durable ingestion rollout. Keep disabled until the corresponding gate passes.
DURABLE_INBOX_ENABLED=false
INGESTION_SHADOW_ENABLED=false
SYNC_RECONCILIATION_ENABLED=false

METRICS_TOKEN=

# Encrypted ContentStore
CONTENT_STORE_ROOT=/app/data/content
CONTENT_STORE_KEY=
CONTENT_STORE_KEY_VERSION=v1

# Lark application and explicit operator allowlist.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
LARK_CHAT_ID=
LARK_ALLOWED_OPEN_IDS=
LARK_DRIVE_FOLDER_TOKEN=

# Exchange API
EXCHANGE_API_URL=
EXCHANGE_API_KEY=
EXCHANGE_ACCOUNT_ID=8
EXCHANGE_ACCOUNT_EMAIL=
EXCHANGE_WEBHOOK_SECRET=
EXCHANGE_SSL_VERIFY=True
EXCHANGE_CA_FILE=
EXCHANGE_FOLDER_SENTITEMS=Sent Items
EXCHANGE_FOLDER_DRAFTS=Drafts
EXCHANGE_FOLDERS_FULL=Inbox
EXCHANGE_FOLDERS_ARCHIVE=
LEADER_SENDERS=
POLLING_INTERVAL=3600

# Input and response limits
WEBHOOK_MAX_BYTES=1048576
EXCHANGE_RESPONSE_MAX_BYTES=67108864
EMAIL_BODY_MAX_BYTES=10485760
EMAIL_ATTACHMENT_MAX_COUNT=20
EMAIL_ATTACHMENT_SINGLE_MAX_BYTES=26214400
EMAIL_ATTACHMENT_TOTAL_MAX_BYTES=52428800

# LLM defaults
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_RPM=15.0
LLM_MAX_INPUT_TOKENS=122880
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_TOTAL_TOKENS=131072
LLM_CATEGORIZER_MODEL=
LLM_DRAFTER_MODEL=
LLM_REVIEWER_MODEL=
LLM_ROUTER_MODEL=
LLM_SUMMARY_MODEL=
LLM_CONSOLIDATOR_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Embedding and Qdrant
QDRANT_URL=http://localhost:6333
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
