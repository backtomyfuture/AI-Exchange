# LLM Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# LLM Rate Limiting
LLM_RATE_LIMIT_DELAY=10
LLM_MAX_RPM=15.0

# SLACK Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=your_channel_id

# LARK Configuration
LARK_APP_ID=cli_a9f1bc4906789bde
LARK_APP_SECRET=y5...
LARK_CHAT_ID=oc_5014e0fefdd12aea07152f9e1c1cc08c
# Lark Webhook Security
LARK_VERIFICATION_TOKEN=your_verification_token
LARK_ENCRYPT_KEY=your_encrypt_key
# Lark Drive (for uploading attachments)
LARK_DRIVE_FOLDER_TOKEN=your_drive_folder_token

# EXCHANGE Configuration
# Exchange API 基础地址（系统会在该基址下调用邮件/通讯录等接口）
EXCHANGE_API_URL=http://your-internal-exchange-api/api/v1/exchange/emails
# Exchange API 访问密钥（放在请求头用于鉴权）
EXCHANGE_API_KEY=your_api_key
# Exchange 账号 ID（告诉后端“以哪个邮箱账号”读取/操作邮件）
EXCHANGE_ACCOUNT_ID=your_account_id
# 用于 Memory/RAG 学习的文件夹（通常填发件箱，用于学习你的历史回复风格）
EXCHANGE_MEMORY_FOLDERS=Sent  # 发件箱用于 Memory 学习用户回复风格
# Exchange Webhook 签名密钥（服务端用它校验回调是否合法）
EXCHANGE_WEBHOOK_SECRET=your_webhook_secret_here
# SSL Verification (set to False for internal/self-signed certs)
EXCHANGE_SSL_VERIFY=False
# 允许接收并处理的 webhook 事件类型（逗号分隔；默认仅新邮件）
EXCHANGE_WEBHOOK_ALLOWED_EVENTS=NewMailEvent
# webhook 去重时间窗口（秒），防止同一事件短时间重复处理
EXCHANGE_WEBHOOK_DEDUP_TTL_SECONDS=600
# “已发送”文件夹名称（用于识别 CreatedEvent 是否来自发件箱）
EXCHANGE_FOLDER_SENTITEMS=Sent Items
# “草稿”文件夹名称（用于识别并忽略草稿相关事件）
EXCHANGE_FOLDER_DRAFTS=Drafts
# Polling Interval (Seconds) - Default 1 hour
POLLING_INTERVAL=3600

# Webhook Event Routing
# 走完整 AI 流程的文件夹（分类、拟稿、卡片通知等；逗号分隔）
EXCHANGE_FOLDERS_FULL=Inbox
# 仅归档/入库、不走 AI 拟稿的文件夹（逗号分隔；留空表示不启用）
EXCHANGE_FOLDERS_ARCHIVE=

# Embedding Configuration
QDRANT_URL=http://localhost:6333
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=your_embedding_model

# App Configuration
DEBUG=False
LOG_LEVEL=INFO
# OAuth 模型（无需 API Key，使用本地 OAuth 凭据）
# LLM_DRAFTER_MODEL=openai-codex/gpt-5.1-codex     # 需要: pip install ai-exchange[codex]
# LLM_CATEGORIZER_MODEL=gemini-cli/gemini-2.5-flash # 需要: gemini auth login
