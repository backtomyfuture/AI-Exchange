# Runtime mode: development, test, or production.
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO
EXTERNAL_URL=http://localhost:8000

# PostgreSQL. Production Compose requires non-empty user/password/database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=email_agent
POSTGRES_USER=
POSTGRES_PASSWORD=

# Checkpoint cleanup. Phase 1 production operations use dry-run only.
# Destructive execution additionally requires an externally issued, signed
# backup receipt and a separate 32-byte-or-longer base64 HMAC key.
CHECKPOINT_CLEANUP_RECEIPT_HMAC_KEY_B64=

# Metrics endpoint authentication. Use a high-entropy token in production.
METRICS_TOKEN=

# Encrypted ContentStore
CONTENT_STORE_ROOT=/app/data/content
# Generate a key without storing it in shell history:
# python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
CONTENT_STORE_KEY=
CONTENT_STORE_KEY_VERSION=v1

# Lark application and explicit operator allowlist (comma-separated open_id).
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
LARK_CHAT_ID=
LARK_ALLOWED_OPEN_IDS=
LARK_DRIVE_FOLDER_TOKEN=

# Exchange API
EXCHANGE_API_URL=
EXCHANGE_API_KEY=
EXCHANGE_ACCOUNT_ID=8
EXCHANGE_ACCOUNT_EMAIL=
EXCHANGE_WEBHOOK_SECRET=
# Keep verification enabled. For a private PKI, set EXCHANGE_CA_FILE to the
# readable PEM bundle instead of disabling verification.
EXCHANGE_SSL_VERIFY=True
EXCHANGE_CA_FILE=
EXCHANGE_FOLDER_SENTITEMS=Sent Items
EXCHANGE_FOLDER_DRAFTS=Drafts
EXCHANGE_FOLDERS_FULL=Inbox
EXCHANGE_FOLDERS_ARCHIVE=
POLLING_INTERVAL=3600

# Input and response limits
WEBHOOK_MAX_BYTES=1048576
EXCHANGE_RESPONSE_MAX_BYTES=67108864
EMAIL_BODY_MAX_BYTES=10485760
EMAIL_ATTACHMENT_MAX_COUNT=20
EMAIL_ATTACHMENT_SINGLE_MAX_BYTES=26214400
EMAIL_ATTACHMENT_TOTAL_MAX_BYTES=52428800

# LLM defaults
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_RPM=15.0
LLM_MAX_INPUT_TOKENS=122880
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_TOTAL_TOKENS=131072

# Optional provider/model overrides
# LLM_DRAFTER_MODEL=openai-codex/gpt-5.1-codex
# LLM_CATEGORIZER_MODEL=gemini-cli/gemini-2.5-flash

# Embedding and Qdrant
QDRANT_URL=http://localhost:6333
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
