# Compose control-plane template. Copy to `.env` only for host-side Compose
# interpolation; the application container receives an explicit allowlist.
# For direct local Python, use `.env.runtime.example` -> `.env.runtime`.
# Runtime mode: development, test, or production.
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO
# Required for production Compose: the real, controlled HTTPS callback origin.
# Keep empty until reverse proxy/DNS is decided; host-side smoke curl may still
# target 127.0.0.1 without weakening this production boundary.
EXTERNAL_URL=
# Give every release/smoke build an explicit tag; all one-shots and the runtime
# use the same immutable build context and recorded image ID.
AI_EXCHANGE_IMAGE=ai-exchange:phase4-lite-local

# PostgreSQL runtime connection. Local Python uses these names directly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=email_agent
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_MIGRATION_OWNER_ROLE=ai_exchange_migration_owner
POSTGRES_MAINTENANCE_ROLE=ai_exchange_checkpoint_maintenance
POSTGRES_CHECKPOINT_AUDITOR_ROLE=ai_exchange_checkpoint_auditor
DATABASE_ROLE_SEPARATION_REQUIRED=false

# Production Compose credential planes. The admin identity is only injected
# into PostgreSQL; the runtime identity is only injected into the application.
# The maintenance identity is referenced here by name only; its DSN is never
# interpolated into the application or database-bootstrap environment.
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_RUNTIME_USER=
POSTGRES_RUNTIME_PASSWORD=

# Fresh dedicated-Compose-volume role provisioning; shared/external clusters
# are rejected. These five host files must be regular 0400/0600 files. The admin
# URL targets POSTGRES_DB and its password equals POSTGRES_ADMIN_PASSWORD. Each
# role password is the source for the matching runtime or one-shot DSN; in
# particular POSTGRES_RUNTIME_PASSWORD must equal the runtime password file.
DATABASE_PROVISION_ADMIN_URL_FILE=./secrets/database_provision_admin_url
POSTGRES_MIGRATION_PASSWORD_FILE=./secrets/postgres_migration_password
POSTGRES_RUNTIME_PASSWORD_FILE=./secrets/postgres_runtime_password
POSTGRES_MAINTENANCE_PASSWORD_FILE=./secrets/postgres_maintenance_password
POSTGRES_CHECKPOINT_AUDITOR_PASSWORD_FILE=./secrets/postgres_checkpoint_auditor_password

# The migration URL itself must be stored in this private file (mode 0600 on
# the host, mounted read-only as a Docker secret). It must start with
# `postgresql://`; libpq keyword DSNs cannot be consumed by Alembic and are
# rejected before DDL. Never place it in this env.
MIGRATION_DATABASE_URL_FILE=./secrets/migration_database_url

# Checkpoint maintenance uses separate one-shot plan and execute identities.
# The auditor DSN belongs to a NOINHERIT login with zero memberships and direct
# column-level SELECT only on the checkpoint-plan manifest; the execute DSN belongs
# to the restricted DELETE-capable maintenance role. The verification public key is
# mounted only into execute. The external backup system alone retains the
# private signing seed. Source files must be regular files without group/other
# access. Both DSNs use options
# `-csearch_path=pg_catalog,<POSTGRES_SCHEMA>`. The public-key file contains one
# base64-encoded raw Ed25519 public key (exactly 32 decoded bytes).
CHECKPOINT_AUDITOR_DATABASE_URL_FILE=./secrets/checkpoint_auditor_database_url
CHECKPOINT_MAINTENANCE_DATABASE_URL_FILE=./secrets/checkpoint_maintenance_database_url
CHECKPOINT_MAINTENANCE_RECEIPT_ED25519_PUBLIC_KEY_FILE=./secrets/checkpoint_maintenance_receipt_ed25519_public_key
# Dedicated operator DSN for scripts/manage_ingestion.py. The referenced file
# must be a regular 0400/0600 file and use the restricted maintenance role.
INGESTION_MAINTENANCE_DATABASE_URL_FILE=./secrets/ingestion_maintenance_database_url

# Phase4-Lite rollout. Keep the safe template default false. Set only
# DURABLE_INBOX_ENABLED=true after fresh bootstrap + greenfield initialization
# and real Exchange/Lark/model credentials are ready. Shadow and Sync polling
# are outside the lean single-account launch and must remain false.
DURABLE_INBOX_ENABLED=false
INGESTION_SHADOW_ENABLED=false
SYNC_RECONCILIATION_ENABLED=false
INGESTION_INSTANCE_ID=ai-exchange-web
INGESTION_LEASE_SECONDS=30
INGESTION_HEARTBEAT_SECONDS=10
INGESTION_SHUTDOWN_SECONDS=30

# Metrics endpoint authentication. Use a high-entropy token in production.
METRICS_TOKEN=

# Encrypted ContentStore
CONTENT_STORE_ROOT=/app/data/content
# Generate a key without storing it in shell history:
# python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
CONTENT_STORE_KEY=
CONTENT_STORE_KEY_VERSION=v1

# Lark application and explicit operator allowlist (comma-separated open_id).
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
LARK_CHAT_ID=
LARK_ALLOWED_OPEN_IDS=
LARK_DRIVE_FOLDER_TOKEN=

# Exchange API
EXCHANGE_API_URL=
EXCHANGE_API_KEY=
EXCHANGE_ACCOUNT_ID=8
EXCHANGE_ACCOUNT_EMAIL=
EXCHANGE_WEBHOOK_SECRET=
# Keep verification enabled. EXCHANGE_CA_FILE is for direct local Python only.
# For production Compose endpoints reached by IP while the certificate covers a
# DNS name, use docker-compose.exchange-tls.yml with the three controls below.
# EXCHANGE_API_URL must use the exact certificate-covered EXCHANGE_TLS_HOSTNAME;
# EXCHANGE_CA_FILE_HOST must be a readable public PEM trust bundle (not a key).
EXCHANGE_SSL_VERIFY=True
EXCHANGE_CA_FILE=
EXCHANGE_TLS_HOSTNAME=
EXCHANGE_TLS_IP=
EXCHANGE_CA_FILE_HOST=
EXCHANGE_FOLDER_SENTITEMS=Sent Items
EXCHANGE_FOLDER_DRAFTS=Drafts
EXCHANGE_FOLDERS_FULL=Inbox
EXCHANGE_FOLDERS_ARCHIVE=
LEADER_SENDERS=
# Legacy polling setting; src.main does not start a polling loop in Phase4-Lite.
POLLING_INTERVAL=3600

# Input and response limits
WEBHOOK_MAX_BYTES=1048576
EXCHANGE_RESPONSE_MAX_BYTES=67108864
EMAIL_BODY_MAX_BYTES=10485760
EMAIL_ATTACHMENT_MAX_COUNT=20
EMAIL_ATTACHMENT_SINGLE_MAX_BYTES=26214400
EMAIL_ATTACHMENT_TOTAL_MAX_BYTES=52428800

# LLM defaults
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_RPM=15.0
LLM_MAX_INPUT_TOKENS=122880
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_TOTAL_TOKENS=131072

# Optional provider/model overrides
# LLM_DRAFTER_MODEL=openai-codex/gpt-5.1-codex
# LLM_CATEGORIZER_MODEL=gemini-cli/gemini-2.5-flash

# Embedding and Qdrant
QDRANT_URL=http://localhost:6333
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
