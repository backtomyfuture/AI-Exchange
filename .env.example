# AI Exchange user configuration
# Copy this file to `.env` and fill in these 17 values only.
# Database credentials, runtime security tokens, limits, and deployment details
# are generated and managed by `scripts/configure_deployment.py`.

# Service
EXTERNAL_URL=https://ai-exchange.example.com

# Exchange
EXCHANGE_API_URL=https://exchange.example.com/api/v1/exchange/emails
EXCHANGE_API_KEY=
EXCHANGE_ACCOUNT_ID=
EXCHANGE_ACCOUNT_EMAIL=
EXCHANGE_WEBHOOK_SECRET=

# Lark
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
LARK_CHAT_ID=
LARK_ALLOWED_OPEN_IDS=

# LLM
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gemini-3-flash

# Embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
